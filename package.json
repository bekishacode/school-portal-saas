{
  "name": "school-portal-saas",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant school management SaaS - monorepo root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "feature": "bash deploy/scripts/new-feature.sh",
    "pr": "bash deploy/scripts/push-and-pr.sh",
    "release": "bash deploy/scripts/release.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

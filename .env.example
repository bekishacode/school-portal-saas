# --- Deploy scripts (deploy/scripts) ---
# Optional: only needed if you want the scripts to authenticate to GitHub
# without an interactive browser login. If you've already run
# `gh auth login` once on this machine, you can leave this blank.
# Create at: https://github.com/settings/tokens (classic token, 'repo' scope)
GH_PAT=

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_portal

# --- API (apps/api) ---
PORT=4000
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- File storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS gateway ---
SMS_API_KEY=
SMS_SENDER_ID=
